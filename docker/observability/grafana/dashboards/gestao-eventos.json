{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Check-ins realizados",
      "id": 1,
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "sum(eventops_checkins_total{resultado=\"realizado\"})", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Repeticoes idempotentes",
      "id": 2,
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [{"expr": "sum(eventops_checkins_total{resultado=\"repetido\"})", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Requisicoes por status",
      "id": 3,
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [{
        "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"gestao-eventos\"}[5m]))",
        "legendFormat": "{{status}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Latencia HTTP p95",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"gestao-eventos\"}[5m])))",
        "legendFormat": "p95",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Heap JVM",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "jvm_memory_used_bytes{application=\"gestao-eventos\",area=\"heap\"}", "legendFormat": "usado", "refId": "A"},
        {"expr": "jvm_memory_max_bytes{application=\"gestao-eventos\",area=\"heap\"}", "legendFormat": "maximo", "refId": "B"}
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["gestao-eventos", "spring-boot"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Gestão de Eventos - Operação",
  "uid": "gestao-eventos-operacao",
  "version": 1
