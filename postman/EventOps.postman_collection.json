{
  "info": {
    "_postman_id": "9c402f93-5f2e-42dd-b181-75389e39a1de",
    "name": "EventOps - Fluxo completo",
    "description": "Fluxo real com Keycloak, organizacao, evento, capacidade, convite, indicacao, QR, check-in idempotente, fila e auditoria.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Autenticacao",
      "item": [
        {
          "name": "Token organizador",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('Token emitido', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('tokenOrganizador', json.access_token);",
              "const sufixo = Date.now().toString();",
              "pm.collectionVariables.set('sufixo', sufixo);",
              "pm.collectionVariables.set('inicioEm', new Date(Date.now() + 172800000).toISOString());",
              "pm.collectionVariables.set('fimEm', new Date(Date.now() + 201600000).toISOString());",
              "pm.collectionVariables.set('expiraEm', new Date(Date.now() + 86400000).toISOString());"
            ]}
          }],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "grant_type", "value": "password", "type": "text"},
                {"key": "client_id", "value": "eventops-postman", "type": "text"},
                {"key": "username", "value": "organizador", "type": "text"},
                {"key": "password", "value": "eventops123", "type": "text"}
              ]
            },
            "url": "{{keycloakUrl}}/realms/eventops/protocol/openid-connect/token"
          }
        },
        {
          "name": "Token operador",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('Token emitido', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenOperador', pm.response.json().access_token);"
            ]}
          }],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "grant_type", "value": "password", "type": "text"},
                {"key": "client_id", "value": "eventops-postman", "type": "text"},
                {"key": "username", "value": "operador", "type": "text"},
                {"key": "password", "value": "eventops123", "type": "text"}
              ]
            },
            "url": "{{keycloakUrl}}/realms/eventops/protocol/openid-connect/token"
          }
        }
      ]
    },
    {
      "name": "02 - Organizacao",
      "item": [
        {
          "name": "Criar organizacao",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Organizacao criada', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('organizacaoId', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"EventOps Postman {{sufixo}}\",\n  \"documento\": \"DEMO-{{sufixo}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/organizacoes"
          }
        },
        {
          "name": "Adicionar operador",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Operador associado', () => pm.response.to.have.status(201));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Carlos Check-in\",\n  \"email\": \"operador@eventops.local\",\n  \"papel\": \"OPERADOR_CHECKIN\"\n}"},
            "url": "{{baseUrl}}/api/v1/organizacoes/{{organizacaoId}}/membros"
          }
        }
      ],
      "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOrganizador}}", "type": "string"}]}
    },
    {
      "name": "03 - Evento",
      "item": [
        {
          "name": "Criar evento",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Evento criado em rascunho', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('RASCUNHO'); });",
            "pm.collectionVariables.set('eventoId', pm.response.json().id);",
            "pm.collectionVariables.set('slug', pm.response.json().slug);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"organizacaoId\": \"{{organizacaoId}}\",\n  \"titulo\": \"Java Summit {{sufixo}}\",\n  \"descricao\": \"Evento profissional criado pela colecao.\",\n  \"local\": \"Centro de Convencoes\",\n  \"fusoHorario\": \"America/Sao_Paulo\",\n  \"inicioEm\": \"{{inicioEm}}\",\n  \"fimEm\": \"{{fimEm}}\",\n  \"capacidade\": 3\n}"},
            "url": "{{baseUrl}}/api/v1/eventos"
          }
        },
        {
          "name": "Publicar evento",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Evento publicado', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('PUBLICADO'); });"
          ]}}],
          "request": {"method": "POST", "header": [], "url": "{{baseUrl}}/api/v1/eventos/{{eventoId}}/publicacao"}
        },
        {
          "name": "Consultar evento publico",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Evento visivel', () => pm.response.to.have.status(200));"]}}],
          "request": {"auth": {"type": "noauth"}, "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/publico/eventos/{{slug}}"}
        }
      ],
      "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOrganizador}}", "type": "string"}]}
    },
    {
      "name": "04 - Inscricoes e aquisicao",
      "item": [
        {
          "name": "Inscricao direta - Ana",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Vaga confirmada', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('CONFIRMADA'); });",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('inscricaoAnaId', json.id);",
            "pm.collectionVariables.set('tokenCancelamentoAna', json.tokenCancelamento);",
            "pm.collectionVariables.set('codigoIndicacao', json.codigoIndicacao);",
            "pm.collectionVariables.set('tokenCredencial', json.credencial.token);",
            "pm.collectionVariables.set('chaveCheckIn', 'check-in-' + Date.now());"
          ]}}],
          "request": {
            "auth": {"type": "noauth"}, "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Ana Souza\",\n  \"email\": \"ana.{{sufixo}}@example.com\"\n}"},
            "url": "{{baseUrl}}/api/v1/publico/eventos/{{slug}}/inscricoes"
          }
        },
        {
          "name": "Inscricao indicada - Bruno",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Indicacao atribuida', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().origem).to.eql('INDICACAO'); });",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('inscricaoBrunoId', json.id);",
            "pm.collectionVariables.set('tokenCancelamentoBruno', json.tokenCancelamento);"
          ]}}],
          "request": {
            "auth": {"type": "noauth"}, "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Bruno Lima\",\n  \"email\": \"bruno.{{sufixo}}@example.com\",\n  \"codigoIndicacao\": \"{{codigoIndicacao}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/publico/eventos/{{slug}}/inscricoes"
          }
        },
        {
          "name": "Criar convite - Carla",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Convite criado', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('tokenConvite', pm.response.json().token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Carla Dias\",\n  \"email\": \"carla.{{sufixo}}@example.com\",\n  \"expiraEm\": \"{{expiraEm}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/eventos/{{eventoId}}/convites",
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOrganizador}}", "type": "string"}]}
          }
        },
        {
          "name": "Aceitar convite - Carla",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Convite aceito', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().origem).to.eql('CONVITE'); });"
          ]}}],
          "request": {
            "auth": {"type": "noauth"}, "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Carla Dias\",\n  \"email\": \"carla.{{sufixo}}@example.com\",\n  \"tokenConvite\": \"{{tokenConvite}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/publico/eventos/{{slug}}/inscricoes"
          }
        },
        {
          "name": "Inscricao em lista de espera - Diego",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Entrou na fila', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('LISTA_ESPERA'); });",
            "pm.collectionVariables.set('inscricaoEsperaId', pm.response.json().id);"
          ]}}],
          "request": {
            "auth": {"type": "noauth"}, "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Diego Reis\",\n  \"email\": \"diego.{{sufixo}}@example.com\"\n}"},
            "url": "{{baseUrl}}/api/v1/publico/eventos/{{slug}}/inscricoes"
          }
        },
        {
          "name": "Consultar ranking",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Ranking calculado', () => pm.response.to.have.status(200));"]}}],
          "request": {"auth": {"type": "noauth"}, "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/publico/eventos/{{slug}}/ranking"}
        }
      ]
    },
    {
      "name": "05 - Credencial e check-in",
      "item": [
        {
          "name": "Consultar credencial",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Credencial ativa', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ATIVA'); });"]}}],
          "request": {"auth": {"type": "noauth"}, "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/publico/credenciais/{{tokenCredencial}}"}
        },
        {
          "name": "Baixar QR Code",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('PNG gerado', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('image/png'); });"]}}],
          "request": {"auth": {"type": "noauth"}, "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/publico/credenciais/{{tokenCredencial}}/qrcode"}
        },
        {
          "name": "Realizar check-in",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Check-in criado', () => pm.response.to.have.status(201));"]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperador}}", "type": "string"}]},
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Idempotency-Key", "value": "{{chaveCheckIn}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"tokenCredencial\": \"{{tokenCredencial}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/eventos/{{eventoId}}/check-ins"
          }
        },
        {
          "name": "Repetir check-in com a mesma chave",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Resposta reproduzida', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'); });"
          ]}}],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOperador}}", "type": "string"}]},
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Idempotency-Key", "value": "{{chaveCheckIn}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"tokenCredencial\": \"{{tokenCredencial}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/eventos/{{eventoId}}/check-ins"
          }
        }
      ]
    },
    {
      "name": "06 - Cancelamento e operacao",
      "item": [
        {
          "name": "Cancelar Bruno e promover Diego",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Fila promovida', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().inscricaoPromovidaId).to.eql(pm.collectionVariables.get('inscricaoEsperaId')); });"
          ]}}],
          "request": {
            "auth": {"type": "noauth"}, "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"tokenCancelamento\": \"{{tokenCancelamentoBruno}}\"\n}"},
            "url": "{{baseUrl}}/api/v1/publico/inscricoes/{{inscricaoBrunoId}}/cancelamento"
          }
        },
        {
          "name": "Listar inscricoes",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Lista paginada', () => pm.response.to.have.status(200));"]}}],
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/eventos/{{eventoId}}/inscricoes?page=0&size=20"}
        },
        {
          "name": "Consultar auditoria",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Auditoria disponivel', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().totalElementos).to.be.above(0); });"]}}],
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/organizacoes/{{organizacaoId}}/auditorias?page=0&size=20"}
        }
      ],
      "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOrganizador}}", "type": "string"}]}
    }
  ],
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenOrganizador}}", "type": "string"}]},
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8081"},
    {"key": "keycloakUrl", "value": "http://localhost:18082"},
    {"key": "tokenOrganizador", "value": ""},
    {"key": "tokenOperador", "value": ""},
    {"key": "sufixo", "value": ""},
    {"key": "organizacaoId", "value": ""},
    {"key": "eventoId", "value": ""},
    {"key": "slug", "value": ""},
    {"key": "inicioEm", "value": ""},
    {"key": "fimEm", "value": ""},
    {"key": "expiraEm", "value": ""},
    {"key": "codigoIndicacao", "value": ""},
    {"key": "tokenConvite", "value": ""},
    {"key": "inscricaoAnaId", "value": ""},
    {"key": "tokenCancelamentoAna", "value": ""},
    {"key": "inscricaoBrunoId", "value": ""},
    {"key": "tokenCancelamentoBruno", "value": ""},
    {"key": "inscricaoEsperaId", "value": ""},
    {"key": "tokenCredencial", "value": ""},
    {"key": "chaveCheckIn", "value": ""}
  ]
}
